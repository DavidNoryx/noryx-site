# The drone captures: 1.8 GB of raw RTK photography. The frames the site
# actually uses are already processed into noryx/assets, so the originals stay
# out of version control. Keep them backed up separately.
public images/

# Dependencies and build caches
node_modules/
noryx-poc/node_modules/
noryx-poc/dist/

# Vercel links this folder to a project id; it is machine state, not source
.vercel/

# Build artefacts that any checkout can regenerate with `node build.mjs`
noryx-deploy.zip
site.zip

# The proprietary field workflow. It was deliberately taken off the website to
# protect it, so it does not belong in a repository either, private or not.
noryx-process.jpeg
תהליך NORYX נגיש.jpeg
תהליך NORYX לא נגיש.jpeg

# Working screenshots and the third party skill bundle
review/
10k-websites-skill/
10k-websites-skill.zip

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Vercel agent skills, installed by `npx skills add vercel-labs/agent-skills`.
# Third-party files that skills-lock.json can reinstall, so the lock file is
# tracked and the 2.2 MB of skill content is not.
.agents/
.claude/skills/

# The POC's generated capture assets: a 10.9 MB GLB, decimated point cloud
# binaries and radargram exports. They are produced from the raw scans by the
# capture pipeline, so they are regenerable and do not belong in git history,
# where they would stay for good even after a later delete.
noryx-poc/public/site-a/
noryx-poc/public/evidence/
noryx-poc/public/draco/

# The humanizer skill archive is installed on the Claude account, not part of
# this website.
humanizer-he.zip

# Hand-upload bundle for Cloudflare Pages; regenerate from noryx/ whenever needed
noryx-cloudflare.zip

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
