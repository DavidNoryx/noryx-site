node_modules/
noryx-poc/node_modules/
noryx-poc/dist/

# Vercel links this folder to a project id; it is machine state, not source
.vercel/

# Build artefacts that any checkout can regenerate with `node build.mjs`
noryx-deploy.zip
site.zip

